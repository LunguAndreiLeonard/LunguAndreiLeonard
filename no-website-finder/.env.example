# Copiază în .env (sau setează în Vercel/Netlify → Environment Variables).
# TOATE stau pe server — niciodată în browser.

# Claude (AI: search din limbaj natural, scoring, mesaje outreach)
ANTHROPIC_API_KEY=sk-ant-...

# Google Places API (New) — rulează pe server, pe cheia TA
GOOGLE_PLACES_KEY=AIza...

# Stripe (plăți €5/oraș)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Secret random pentru semnarea creditelor (ex: openssl rand -hex 32)
CREDIT_SECRET=schimba-ma-cu-un-secret-random-lung

# Preț per oraș, în cenți (500 = €5). Opțional.
PRICE_EUR_CENTS=500
